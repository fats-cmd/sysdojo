# sysdojo environment variables — copy to .env (never commit real secrets).
# The API and `npm run db:migrate` read the repo-root .env automatically;
# variables exported in your shell take precedence.
#
# With NODE_ENV=production the API REFUSES TO START unless JWT_SECRET,
# DATABASE_URL and SUPABASE_URL are all set to real values. That is
# deliberate: every development default below is an authentication bypass
# in production.

# ---- apps/api ----
# "production" turns on the strict checks described above. Anything else
# (or unset) is development.
# NODE_ENV=production
# Port the API listens on.
PORT=3000
# Secret used to sign our own access tokens. REQUIRED in production, where it
# must be at least 32 characters and must not be the placeholder below.
#   generate one:  openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
# Override where YAML question content is loaded from (defaults to ./content).
# CONTENT_DIR=/absolute/path/to/content
# Postgres connection for persistent storage (docker compose up -d db).
# REQUIRED in production. Leave commented for the in-memory dev store
# (data resets on API restart).
# The database name must match POSTGRES_DB in docker-compose.yml.
# DATABASE_URL=postgresql://sysdojo:sysdojo@localhost:5432/sysdojo
# Separate database used by the PrismaStore contract tests (optional).
# TEST_DATABASE_URL=postgresql://sysdojo:sysdojo@localhost:5432/sysdojo_test
# Browser origin allowed by CORS (only matters for Expo web). Defaults to *.
# CORS_ORIGIN=http://localhost:8081
# Number of reverse proxies in front of the API. Rate limiting keys on the
# client IP, and without this every request looks like it came from the
# proxy. Leave unset when nothing is in front of the API — trusting
# X-Forwarded-For with no proxy lets any client spoof its address.
# TRUST_PROXY=1

# ---- auth provider (Supabase) ----
# Your project URL. Setting this switches /v1/auth/login to verifying real
# Supabase access tokens, disables the credential-free /v1/auth/dev endpoint,
# and pins the expected token issuer. REQUIRED in production.
# Tokens are verified against the project's published public signing keys
# (${SUPABASE_URL}/auth/v1/.well-known/jwks.json) — no shared secret needed,
# and Supabase can rotate keys without a redeploy.
# SUPABASE_URL=https://yourproject.supabase.co
# Legacy shared HS256 secret (Dashboard → Settings → API). Only needed for
# projects that have not migrated to asymmetric JWT signing keys. It is a
# symmetric secret — anything that can verify a token can also mint one — so
# prefer SUPABASE_URL alone once your project has migrated.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Keep the credential-free dev login available even with Supabase configured
# (local testing only). Refused outright when NODE_ENV=production.
# ALLOW_DEV_LOGIN=1

# ---- apps/mobile ----
# Where the app finds the API. Usually leave this unset: the app resolves it
# automatically (Metro's LAN IP on physical devices, 10.0.2.2 on Android
# emulators, localhost elsewhere). Set it only when the API runs on another
# machine or port. No trailing slash.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Supabase project for OAuth sign-in (Dashboard → Settings → API). Leave
# unset for zero-config dev login. Use with the API's SUPABASE_URL.
# EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# OAuth providers to offer, comma-separated (must be enabled in Supabase).
# EXPO_PUBLIC_OAUTH_PROVIDERS=github,google
